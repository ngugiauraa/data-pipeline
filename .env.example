# Copy to .env (never commit .env). Generate secrets with: openssl rand -hex 24
# No API keys are needed: all four data sources are keyless.

POSTGRES_PASSWORD=change-me
WAREHOUSE_PASSWORD=change-me-too
AIRFLOW_SECRET_KEY=change-me-long-random
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Linux only: your user id (run `id -u`) so files in ./data are owned by you.
# On Windows/macOS Docker Desktop leave it as 50000.
AIRFLOW_UID=50000
